! ------------------------
! Verbal inflection lexica
! ------------------------

LEXICON INF-PRS-PTC
 +Inf: # ;
 +PrsPrc:%>ande # ;
 +Imp:%> # ;

LEXICON a-PRES
 +Ind+Prs:%>ar # ;

LEXICON a-PRET-PTC
 +Ind+Prt:%>a # ;
 +PrfPrc:%>a # ;

LEXICON e-PRES
 +Ind+Prs:%>er # ;

LEXICON t-PRET-PTC
 +Ind+Prt:%>t # ;
 +PrfPrc:%>te # ;

LEXICON r-PRES
 +Ind+Prs:%>r # ;

LEXICON dd-PRET-PTC
 +Ind+Prt:%>dde # ;
 +PrfPrc:%>dd # ;

LEXICON de-PRET-PTC
 +Ind+Prt:%>de # ;
 +PrfPrc:%>d # ;

