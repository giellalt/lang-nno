! ------------------------
! Verbal inflection lexica
! ------------------------

LEXICON INF-PRS-PTC
 +Inf: # ;
 +PrsPtc:%>ande # ;
 +Imp:%> # ;

LEXICON a-PRES
 +Ind+Prs:%>ar # ;

LEXICON a-PRET-PTC
 +Ind+Prt:%>a # ;
 +PrfPtc:%>a # ;

LEXICON e-PRES
 +Ind+Prs:%>er # ;

LEXICON t-PRET-PTC
 +Ind+Prt:%>t # ;
 +PrfPtc:%>te # ;

LEXICON r-PRES
 +Ind+Prs:%>r # ;

LEXICON dd-PRET-PTC
 +Ind+Prt:%>dde # ;
 +PrfPtc:%>dd # ;

LEXICON de-PRET-PTC
 +Ind+Prt:%>de # ;
 +PrfPtc:%>d # ;

