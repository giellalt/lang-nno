!! INTRODUCTION TO MORPHOLOGICAL ANALYSER OF Norwegian Nynorsk LANGUAGE.

! ======================
! Sublexica for NounRoot
! ======================

! Basic paradigms
! ===============

! Msculines
! ----------

! Ordbank mapping: 761 -> M0
LEXICON M0
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl: ar-ane ;

LEXICON M0-us ! RADIUS
 +N+Msc+Sg:%>us 0-en ;
 +N+Msc+Sg+Def:%>en K ; ! short def
 +N+Msc+Pl: er-ene ; ! Regular pl

LEXICON TING
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl: 0-a ;

! Ordbank mapping: 764 -> MANN
LEXICON MANN
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl:Z1 0-a ;

LEXICON M0N0
 M1 ;
 N0 ;

LEXICON M0N1
 M1 ;
 N1 ;

LEXICON M0f
 +M+Msc+Pl: 0-a ;

! Ordbank mapping: 700, 701 -> M1
LEXICON M1
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl: ar-ane ;

LEXICON M1M1dt
 K ;

LEXICON M1M1m
 +N+Msc+Sg:mX4 0-en ;
 +N+Msc+Pl:mX4 ar-ane ;
 +N+Msc+Pl:m ar-ane ;
 K ;

LEXICON M1M1tN1N1s
 K ;

LEXICON M1M3o
 K ;

LEXICON M1N0
 M1 ;
 N0 ;

LEXICON M1N1
 M1 ;
 N1 ;

LEXICON M1N1N1s
 M1 ;
 N1N1s ;

LEXICON M1N1sN1t
 M1 ;
 N1sN1t ;

! Ordbank mapping: 721, 739 -> M1dt
LEXICON M1dt
 K ;

LEXICON M1e
 K ;

LEXICON M1eM1em
 K ;

LEXICON M1eM1me
 K ;

LEXICON M1eN1dseN1e
 M1e ;
 N1dseN1e ;

LEXICON M1eN1e
 M1e ;
 N1e ;

LEXICON M1eN1eN1es
 M1e ;
 N1eN1es ;

LEXICON M1em
 K ;

LEXICON M1emN1em
 M1em ; 
 N1em ;

LEXICON M1f
 +N+Msc+Pl+Indef: K ;
 +N+Msc+Pl+Def:%>X3ne K ;

LEXICON M1m
 +N+Msc+Sg:mX4 0-en ;
 +N+Msc+Pl: ar-ane ;

LEXICON M1me
 K ;

LEXICON M1tN1
 M1t ; 
 N1 ;

LEXICON M1tN1sN1t
 M1t ;
 N1sN1t ;

LEXICON M1to
 K ;

! Ordbank mapping: 702 -> M2
LEXICON M2
 M1 ;

LEXICON M2N2
 M2 ;
 N2 ;

LEXICON M2e
 K ;

LEXICON M3 ! KOLLEGA
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl: ar-ane ;
! +N+Msc+Pl: er-ene ;
 +N+Msc+Pl:X2 er-ene ; ! delete a

! Ordbank mapping: 720, 722 -> M1t
LEXICON M1t ! FINGER
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl:X1 ar-ane ; ! X1 deletes the vowel -e-

!LEXICON BAKER
! +N+Msc+Sg: 0-en ;
! +N+Msc+Pl: e-ne ;

LEXICON M1M1t ! METER
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl:X1 0-ane ;

! Ordbank mapping: 763 -> M3o
LEXICON M3o ! BONDE
 +N+Msc+Sg: 0-en ;
 +N+Msc+Pl:Z1 er-ene ; ! Umlaut

LEXICON M4 ! FORSTAD
 +N+Msc+Sg: 0-en ;
 +N+Msc+Sg:Z1 er-ene ; ! Umlaut

LEXICON M0M1 ! KONTO
 +N+Msc+Sg: 0-en K ;
 +N+Msc+Pl:X2i 0-ene ; ! delete o
 +N+Msc+Pl: er-ene ; ! Regular pl

LEXICON M3N0N1
 M3 ;
 N0N1 ;

LEXICON M3N1
 M3 ;
 N1 ;

LEXICON M3e
 K ;

LEXICON M3oN1
 M3o ;
 N1 ;

LEXICON M4M4m
 K ;

LEXICON M4N1
 M4 ;
 N1 ;

! Feminines
! ---------

! Ordbank mapping: 965 -> F0
LEXICON F0 ! ku
 +N+Fem+Sg: 0-a ;
 +N+Fem+Pl: er-ene ;

LEXICON F0o
 +N+Fem+Sg: 0-a ;
 +N+Fem+Pl:Z1 r-rne ;

LEXICON F0f !Plural
 +N+Fem+Pl+Indef: K ;

LEXICON F0F1
 +N+Fem+Sg: 0-a ;
 +N+Fem+Pl: er-ene ;

LEXICON DONNA
 +N+Fem+Sg: 0-a ;
 +N+Fem+Sg+Def: K ;
 +N+Fem+Pl: er-ene ;

LEXICON F0F1M3
 F0F1 ;
 M3 ;

LEXICON F0F1o
 +N+Fem+Sg: 0-a ;
 +N+Fem+Pl: er-ene ;
 +N+Fem+Pl:Z1 er-ene ;

! Ordbank mapping: 900 -> F1
LEXICON F1 ! pil
 +N+Fem+Sg: 0-a ;
 +N+Fem+Pl: er-ene ;

! Ordbank mapping: 968, 973 -> F1o
LEXICON F1o ! bok
 +N+Fem+Sg: 0-a ;
 +N+Fem+Pl:Z1 er-ene ;

LEXICON F1F0
 F0F1 ;

LEXICON F1F1o
