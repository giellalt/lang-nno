! Ordbank mapping: 923 -> F1t
LEXICON F1t
 K ;

LEXICON F1to
 K ;

! Ordbank mapping: 905 -> F2
LEXICON F2 ! jente
 +N+Fem+Sg: 0-a ;
 +N+Fem+Pl: er-ene ;
 +N+Fem+Pl: or-one ;

LEXICON F2M2
