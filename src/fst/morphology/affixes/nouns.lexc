! Lexica for definiteness declension
! ==================================

LEXICON 0-en
! +Indef:X3 K ;
 +Indef: K ;
 +Def:%>en K ;

LEXICON 0-ene
 +Indef: K ;
 +Def:%>ene K ;

LEXICON 0-a
 +Indef: K ;
 +Def:%>a K ;
 +Def:%>i K ;

LEXICON 0-ane
 +Indef: K ;
 +Def:%>ane K ;

LEXICON 0-et
 +Indef: K ;
 +Def:%>et K ;

LEXICON ar-ane
 +Indef:%>ar K ;
 +Def:%>ane K ;

!LEXICON e-ne
! +Indef:%>e K ;
! +Def:%>ne K ;

LEXICON er-ene
 +Indef:%>er K ;
 +Def:%>ene K ;

LEXICON or-one
 +Indef:%>or K ;
 +Def:%>one K ;

LEXICON r-rne
 +Indef:%>r K ;
 +Def:%>nre K ;

