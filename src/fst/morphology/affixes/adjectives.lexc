! ========================================================================== !
! !!            !!!Norwegian Nynorsk morphological analyser                  !
! ========================================================================== !
!! INTRODUCTION TO MORPHOLOGICAL ANALYSER OF Norwegian Nynorsk LANGUAGE.

! ==========================
! LEXICA FOR ADJECTIVE ROOTS
! ==========================

! Basic paradigms
! ===============

! Ordbank mapping: 501, 535, 540, 541, 550, 551, 553, 570, 571, 575, 575G, 611 -> a1
LEXICON a1 ! 
 +A: positive ;
 +A: a-neuter ;
 +A: a-grade ;

! Ordbank mapping: 510, 511 -> a2
LEXICON a2 ! 
 +A: positive ;
 +A: a-no-neuter ;
 +A: a-grade ;

! Ordbank mapping: 515, 532 -> a3
LEXICON a3 ! 
 +A: positive ;
 +A: a-no-neuter ;

! Sublexica
! =========

LEXICON positive
 +Msc+Sg+Indef: # ;
 +Fem+Sg+Indef: # ;
 +Sg+Def:%>e # ;
 +Pl+Indef:%>e # ;
 +Pl+Def:%>e # ;

LEXICON a-neuter ! fint
 +Neu+Sg+Indef:%>Q3t # ;

LEXICON a-no-neuter ! vennlig
 +Neu+Sg+Indef: # ;

! Ordbank mapping: 629, 654 -> a-grade
LEXICON a-grade
 +Comp:%>are # ;
 +Superl+Indef:%>ast # ;
 +Superl+Def:%>aste # ;

